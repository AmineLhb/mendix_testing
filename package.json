{
  "name": "mendix-test-agent",
  "version": "0.1.0",
  "description": "Record-once, AI-enrich, regress-forever E2E testing for Mendix apps",
  "type": "module",
  "scripts": {
    "record": "playwright codegen",
    "enrich": "node explorer/enrich.js",
    "explore": "node explorer/autonomous-agent.js",
    "test": "playwright test",
    "test:ci": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "report": "node ./scripts/report.js",
    "validate:generated": "node ./scripts/validate-generated-tests.js",
    "validate:env": "node ./scripts/validate-env.js",
    "lint": "eslint . || true",
    "format": "prettier --write .",
    "prepare": "husky install",
    "record-and-enrich": "node ./scripts/record-and-enrich.js",
    "new-test": "node ./scripts/record-and-enrich.js",
    "features:sync": "node ./scripts/sync-features.js",
    "ui": "node ./ui/server.js"
  },
  "bin": {},
  "dependencies": {
    "openai": "^4.68.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "eslint": "^8.44.0",
    "husky": "^8.0.0",
    "lint-staged": "^14.0.0",
    "prettier": "^3.3.3"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix"
    ]
  }
}
