# Copy this file to .env and fill in credentials for this app (never commit .env).
# Tool-level config (GROQ_API_KEY) lives in the repo root .env.example instead
# — it's shared across every project, not specific to this app.

# App under test
BASE_URL=http://localhost:8080

# Default role credentials — used by tests that don't specify a role
# (this is the "Collaborateur" / regular user role: login.spec.js,
# create-visit.spec.js, edit-visit.spec.js all use these).
MENDIX_TEST_USERNAME=
MENDIX_TEST_PASSWORD=

# Per-role credentials — one pair per Mendix role, for tests that need to
# exercise role-specific behavior. Fill in as each role's tests get built.
MENDIX_TEST_USERNAME_MEDECIN=
MENDIX_TEST_PASSWORD_MEDECIN=
MENDIX_TEST_USERNAME_INFIRMIER=
MENDIX_TEST_PASSWORD_INFIRMIER=
MENDIX_TEST_USERNAME_ADMIN_FONCTIONNEL=
MENDIX_TEST_PASSWORD_ADMIN_FONCTIONNEL=
MENDIX_TEST_USERNAME_ADMIN=
MENDIX_TEST_PASSWORD_ADMIN=
