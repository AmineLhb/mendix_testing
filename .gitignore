node_modules/
.env
test-results/
playwright-report/
# Per-project data lives under projects/<name>/ — .env holds real credentials,
# playwright-report/ and test-results/ are regenerated by every run. Raw
# codegen recordings capture literal credentials typed during recording.
projects/*/.env
projects/*/playwright-report/
projects/*/test-results/
projects/*/explorer/raw-*.spec.js
# Regenerated by the UI after every run/record job — not meant to be committed.
projects/*/run-history.json
explorer/exploration-log.json
explorer/exploration-findings.json
explorer/debug-shots/
# Raw codegen recordings capture literal credentials typed during recording.
explorer/raw-*.spec.js
# ...except raw-sample.spec.js, which never had credentials (just a goto) and
# is required by the CI enrich-dry-run job — must stay tracked.
!explorer/raw-sample.spec.js
# Saved browser session/auth state — contains live session cookies.
explorer/*.auth-state.json
explorer/last-replay-steps.debug.json
explorer/dump-widgets-final.png
explorer/api-responses.debug.json
explorer/api-responses-error.png
# Saved browser session/auth state — contains live session cookies.
playwright/.auth.json
playwright-report.json
tmp/
