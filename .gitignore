node_modules/
.env
test-results/
playwright-report/
# Per-project data lives under projects/<name>/ — .env holds real credentials,
# playwright-report/ and test-results/ are regenerated by every run. Raw
# codegen recordings capture literal credentials typed during recording.
projects/*/.env
projects/*/environments/*.env
projects/*/playwright-report/
projects/*/test-results/
projects/*/explorer/raw-*.spec.js
# Unreviewed proposals awaiting approval in the UI (a new test or a
# self-healing fix) — derived from raw recordings, so carries the same
# potential-credential risk until a human approves it; approving moves the
# content out of here into generated-tests/, which IS tracked.
projects/*/explorer/pending/
# Regenerated by the App Scanner on demand — not meant to be committed.
projects/*/explorer/app-scan/
# Regenerated by the authorization boundary scanner on demand — not meant to be committed.
projects/*/explorer/auth-boundary-scan/
# Extend/continue mode's temporary storageState capture — holds live session
# cookies; removed automatically once used, this is defense in depth in case
# the process is interrupted before that cleanup runs.
projects/*/explorer/extend-storage-*.json
# Regenerated on demand — not meant to be committed.
projects/*/explorer/assertion-suggestions/
projects/*/explorer/nl-plans/
# Regenerated by the UI after every run/record job — not meant to be committed.
projects/*/run-history.json
# Regenerated by test-history-reporter.js on every test run — not meant to be committed.
projects/*/test-history.json
# Screenshots test-history-reporter.js copies out of test-results/ so History
# links survive past the next run — local run data, same as test-history.json
# above, not meant to be committed.
projects/*/explorer/test-history-artifacts/
explorer/exploration-log.json
explorer/exploration-findings.json
explorer/debug-shots/
# Raw codegen recordings capture literal credentials typed during recording.
explorer/raw-*.spec.js
# ...except raw-sample.spec.js, which never had credentials (just a goto) and
# is required by the CI enrich-dry-run job — must stay tracked.
!explorer/raw-sample.spec.js
# Saved browser session/auth state — contains live session cookies.
explorer/*.auth-state.json
explorer/last-replay-steps.debug.json
explorer/dump-widgets-final.png
explorer/api-responses.debug.json
explorer/api-responses-error.png
# Saved browser session/auth state — contains live session cookies.
playwright/.auth.json
playwright-report.json
tmp/
